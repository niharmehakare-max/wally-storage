# Generic overrides (take precedence over the OS-specific entries below)
# STORAGE_DIR=
# SOURCE_DIR=

# Set both paths once; the application selects the matching pair at runtime.
WINDOWS_STORAGE_DIR=D:\\storage
WINDOWS_SOURCE_DIR=C:\\Users\\your-user\\new
LINUX_STORAGE_DIR=/home/your-user/storage
LINUX_SOURCE_DIR=/home/your-user/new
